<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:paddingStart="52dp" android:paddingEnd="52dp" android:paddingTop="35dp" android:paddingBottom="35dp" android:clipChildren="false" android:clipToPadding="false">
    <LinearLayout android:layout_width="224dp" android:layout_height="match_parent" android:orientation="vertical" android:paddingEnd="26dp" android:clipChildren="false" android:clipToPadding="false">
        <ImageView android:layout_width="52dp" android:layout_height="52dp" android:padding="13dp" android:src="@drawable/ic_settings" android:background="@drawable/settings_group_bg" android:importantForAccessibility="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/launcher_settings" android:textColor="#FFFFFFFF" android:textSize="32sp" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="18dp" android:text="客厅桌面" android:textColor="#CCDFEAF1" android:textSize="14sp" />
        <TextView android:id="@+id/layoutTab" style="@style/SettingsRow" android:layout_height="46dp" android:text="布局与时间" />
        <TextView android:id="@+id/appearanceTab" style="@style/SettingsRow" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="外观与动效" />
        <TextView android:id="@+id/systemTab" style="@style/SettingsRow" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="系统" />
    </LinearLayout>
    <ScrollView android:id="@+id/settingsPane" android:background="@drawable/settings_group_bg" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:clipToPadding="false" android:scrollbars="none" android:fillViewport="true" android:clipToOutline="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/layoutSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" android:padding="22dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="sans-serif-medium" android:text="布局与时间" android:textSize="25sp" android:textColor="#FFFFFFFF" />
                <TextView android:id="@+id/reorderChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/reorder" android:visibility="gone" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/columns_label" android:textColor="#FFFFFFFF" android:textSize="20sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                    <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                    <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                    <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/rows_below_dock_label" android:textColor="#FFFFFFFF" android:textSize="20sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                    <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                    <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                    <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/dock_opacity_label" android:textColor="#FFFFFFFF" android:textSize="20sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                    <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                    <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                    <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/dream_name" android:textColor="#FFFFFFFF" android:textSize="20sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
                    <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
                    <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:text="@string/clock_format_24" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/appearanceSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" android:padding="22dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="sans-serif-medium" android:text="外观与动效" android:textSize="25sp" android:textColor="#FFFFFFFF" />
                <TextView android:id="@+id/wallpaperChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                <TextView android:id="@+id/animationsChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                <TextView android:id="@+id/advancedChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/advanced_effects_warning" android:textColor="#FFACB8C1" android:textSize="14sp" />
                <TextView android:id="@+id/openOnStartChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:visibility="gone" />
                <TextView android:id="@+id/followThemeChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/follow_theme" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/follow_theme_hint" android:textColor="#FFACB8C1" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/systemSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" android:padding="22dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="sans-serif-medium" android:text="系统" android:textSize="25sp" android:textColor="#FFFFFFFF" />
                <TextView android:id="@+id/defaultHomeChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/home_settings" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/home_settings_help" android:textColor="#FFACB8C1" android:textSize="14sp" />
                <TextView android:id="@+id/tvSettingsChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/tv_settings" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
